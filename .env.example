# ===== mar.IA WhatsApp Bot =====

# Numeros autorizados a enviar comandos (formato E.164 sem +, separados por virgula).
# Ex: 5534999998888,5534988887777
ALLOWED_NUMBERS=5534999999999

# Caminho absoluto para o binário do Claude Code (CL1 — Rev.1.0.1).
# Descubra com `which claude`. Path varia conforme método de instalação:
#   - npm global no /usr/local/bin/claude (instalação clássica)
#   - claude-cli oficial em /root/.local/bin/claude (atual da VPS, 2.1.146)
#   - /root/.claude/local/claude (instalação local-user)
# Validado em 2026-05-20 com Claude Code 2.1.146.
CLAUDE_BIN=/root/.local/bin/claude

# Modelo padrao (claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001)
CLAUDE_MODEL=claude-sonnet-4-6

# Diretorio de trabalho onde o Claude Code roda (deve conter ~/.claude/skills sincronizadas)
CLAUDE_CWD=/root/.agents

# Pasta para arquivos recebidos via WhatsApp
INBOX_DIR=/home/maria/marIA-in

# Pasta para arquivos a devolver via WhatsApp ou Drive
OUTBOX_DIR=/home/maria/marIA-out

# Limite de tamanho (MB) para enviar arquivo direto pelo WhatsApp
# Acima disso, o bot sobe para Drive e devolve link
WHATSAPP_FILE_LIMIT_MB=15

# Timeout (segundos) para uma execucao do claude
CLAUDE_TIMEOUT_SEC=300

# Nivel de log: trace | debug | info | warn | error
LOG_LEVEL=info

# ===== Rate limit per-JID (Rev.1.0.0 / RT1) =====
# Mesmo entre numeros autorizados, evita queimar quota Max do Claude em rajada.
# Default: 30 dispatches / 60 minutos por JID. Comandos administrativos
# (/ping /help /stats /reset /reconnect) NAO contam pro budget.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MIN=60

# ===== Limites de anexo (Rev.1.0.1 / AT2) =====
# Tamanho máximo do anexo recebido via WhatsApp (MB). Default 30. Baileys
# carrega buffer inteiro em RAM — sem limite, um atacante autorizado pode
# disparar OOM.
INBOX_MAX_MB=30
